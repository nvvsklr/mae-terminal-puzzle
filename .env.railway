# Mae Terminal Railway Environment Variables
# Copy these values to your Railway project environment variables

# Required - Set to 'production' for Railway deployment
NODE_ENV=production

# Optional - Discord OAuth (if you want to enable Discord verification)
# DISCORD_CLIENT_ID=your_discord_client_id
# DISCORD_CLIENT_SECRET=your_discord_client_secret

# Optional - Allowed origins (Railway will provide the domain)
# ALLOWED_ORIGINS=https://your-railway-domain.railway.app

# Optional - Rate limiting (defaults are fine for most use cases)
# RATE_LIMIT_POINTS=100
# RATE_LIMIT_DURATION=900